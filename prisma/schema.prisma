generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum GenderEnum {
  Male
  Female
  Others
}

enum MaritalStatusEnum {
  married
  single
  divorced
  widowed
}

// ─── Models ───────────────────────────────────────────────────────────────────

/// Employee master — referenced by the employees route/DAO
model Employee {
  emp_id         BigInt            @id @default(autoincrement())

  emp_code       String            @unique @db.VarChar(20)

  first_name     String            @db.VarChar(100)
  last_name      String            @db.VarChar(100)

  dob            DateTime          @db.Date

  gender         GenderEnum

  marital_status MaritalStatusEnum

  mobile_no      String            @unique @db.VarChar(15)

  personal_email String            @unique @db.VarChar(255)

  aadhar_no      String            @unique @db.VarChar(12)

  pan_no         String            @unique @db.VarChar(10)

  is_active      Boolean           @default(true)

  created_at     DateTime          @default(now()) @db.Timestamptz()

  last_modified  DateTime          @updatedAt @db.Timestamptz()

  @@map("employee")
}

/// Salary Component master — component_type is validated as 'earning' | 'deduction' at the application layer
model SalaryComponent {
  /// Auto-incrementing surrogate primary key (internal use only)
  id             BigInt   @id @default(autoincrement())

  /// Externally-exposed, non-guessable identifier — used in all API routes
  cuid           String   @unique @default(cuid(2)) @db.Text

  component_name String   @db.VarChar(150)

  /// Stored as plain string: 'earning' | 'deduction' — validated at application layer
  component_type String   @db.VarChar(20)

  is_taxable     Boolean  @default(false)

  is_active      Boolean  @default(true)

  created_at     DateTime @default(now()) @db.Timestamptz()

  /// cuid of the user who created this record
  created_by     String?  @db.Text

  updated_at     DateTime @updatedAt @db.Timestamptz()

  /// cuid of the user who last updated this record
  updated_by     String?  @db.Text

  @@unique([component_name, component_type])

  @@map("salary_components")
}
