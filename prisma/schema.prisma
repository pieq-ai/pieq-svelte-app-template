generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum GenderEnum {
  Male
  Female
  Others
}

enum MaritalStatusEnum {
  married
  single
  divorced
  widowed
}

enum SalaryComponentTypeEnum {
  earning
  deduction
}

// ─── Models ───────────────────────────────────────────────────────────────────

/// Employee master — referenced by the employees route/DAO
model Employee {
  emp_id         BigInt            @id @default(autoincrement())

  emp_code       String            @unique @db.VarChar(20)

  first_name     String            @db.VarChar(100)
  last_name      String            @db.VarChar(100)

  dob            DateTime          @db.Date

  gender         GenderEnum

  marital_status MaritalStatusEnum

  mobile_no      String            @unique @db.VarChar(15)

  personal_email String            @unique @db.VarChar(255)

  aadhar_no      String            @unique @db.VarChar(12)

  pan_no         String            @unique @db.VarChar(10)

  is_active      Boolean           @default(true)

  created_at     DateTime          @default(now()) @db.Timestamptz()

  last_modified  DateTime          @updatedAt @db.Timestamptz()

  @@map("employee")
}

/// Salary Component master — the primary module being built
model SalaryComponent {
  id             String                  @id @default(cuid(2))

  component_name String                  @db.VarChar(150)

  component_type SalaryComponentTypeEnum

  is_taxable     Boolean                 @default(false)

  is_active      Boolean                 @default(true)

  @@unique([component_name, component_type])

  @@map("salary_component")
}
