generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id BigInt @id @default(autoincrement())

  emp_code   String @unique @db.VarChar(20)
  cuid      String @unique @default(cuid())
  first_name String @db.VarChar(100)
  last_name  String @db.VarChar(100)

  dob DateTime @db.Date

  gender String @db.VarChar(100)

  blood_group_cuid String
  blood_group       BloodGroup @relation(fields: [blood_group_cuid], references: [cuid])

  marital_status String @db.VarChar(100)

  nationality_cuid String
  nationality       Nationality @relation(fields: [nationality_cuid], references: [cuid])

  mobile_no String @unique @db.VarChar(15)

  personal_email String @unique @db.VarChar(255)

  aadhar_no String @unique @db.VarChar(12)

  pan_no String @unique @db.VarChar(10)

  emergency_contact_name String? @db.VarChar(150)

  emergency_contact_no String? @db.VarChar(15)

  relation_cuid String?
  relation_type  RelationType? @relation(fields: [relation_cuid], references: [cuid])

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("employee")
}

model SystemRoles {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  system_role_name String @unique @db.VarChar(100)

  status          Boolean          @default(true)
  rolePermissions RolePermission[]

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("system_roles")
}

model Department {
  id        Int    @id @default(autoincrement())
  cuid     String @unique @default(cuid())
  dept_name String @unique @db.VarChar(150)

  status Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("department")
}

model Permissions {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  permission_key String @unique @db.VarChar(100)

  status          Boolean          @default(true)
  rolePermissions RolePermission[]

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("permissions")
}

model RolePermission {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  system_role_cuid String
  system_role       SystemRoles @relation(fields: [system_role_cuid], references: [cuid])

  permission_cuid String
  permission       Permissions @relation(fields: [permission_cuid], references: [cuid])

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@unique([system_role_cuid, permission_cuid])
  @@index([cuid])
  @@map("role_permission")
}

model BloodGroup {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  blood_group_name String     @unique @db.VarChar(5)
  employees        Employee[]

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("blood_group")
}

model Designation {
  id               Int    @id @default(autoincrement())
  cuid            String @unique @default(cuid())
  designation_name String @unique @db.VarChar(150)

  status Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("designation")
}

model PayGrade {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  paygrade_name String @unique @db.VarChar(100)

  status Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("pay_grade")
}

model Nationality {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  nationality_name String @unique @db.VarChar(100)

  status    Boolean    @default(true)
  employees Employee[]

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("nationality")
}

model EmploymentType {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  employment_name String @unique @db.VarChar(50)

  status Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("employment_type")
}

model RelationType {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  relation_name String @unique @db.VarChar(50)

  status    Boolean    @default(true)
  employees Employee[]

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("relation_type")
}

model DocumentType {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  document_type_name String @unique @db.VarChar(100)

  status Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("document_type")
}

model State {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  country_cuid String
  country       Country @relation(fields: [country_cuid], references: [cuid])

  state_name String @db.VarChar(100)

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@unique([country_cuid, state_name])
  @@index([country_cuid])
  @@index([cuid])
  @@map("state")
}

model Country {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  country_name String  @unique @db.VarChar(100)
  states       State[]

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("country")
}

model Skills {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  skills_name String @unique @db.VarChar(100)

  status Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("skills")
}

model AttendanceSource {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  attendance_source_name String @unique @db.VarChar(100)

  status Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("attendance_source")
}

model Languages {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  languages_name String @unique @db.VarChar(100)

  status Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@index([cuid])
  @@map("languages")
}
