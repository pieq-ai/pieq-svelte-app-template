generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  name String @unique @db.VarChar(255)

  status Boolean @default(true)

  @@map("roles")
}

model Shift {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  shift_name String @unique @db.VarChar(100)

  start_time DateTime @db.Time(6)

  end_time DateTime @db.Time(6)

  minimum_work_hours Decimal @db.Decimal(4, 2)

  status Boolean @default(true)

  @@map("shifts")
}

model CompanyLocation {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  location_name String @unique @db.VarChar(150)

  address_line1 String @db.VarChar(255)

  address_line2 String? @db.VarChar(255)

  city String @db.VarChar(100)

  state_cuid String @db.VarChar(50)

  country_cuid String @db.VarChar(50)

  pin_code String @db.VarChar(10)

  timezone String @db.VarChar(60)

  is_active Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()

  updated_at DateTime @updatedAt @db.Timestamptz()

  @@map("company_locations")
}

model State {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  country_cuid String @db.VarChar(50)

  state_name String @db.VarChar(100)

  @@unique([country_cuid, state_name])

  @@map("states")
}

model Country {
  id Int @id @default(autoincrement())

  cuid String @unique @default(cuid())

  country_name String @unique @db.VarChar(100)

  @@map("countries")
}
