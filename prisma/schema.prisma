  check_out_time DateTime? @db.Timestamptz(3)
  work_duration_minutes Int?
  status String @db.VarChar(20)
  attendance_source_cuid String? @db.Text
  remarks String? @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(3)
  created_by String? @db.Text
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updated_by String? @db.Text

  check_in_latitude Float?
  check_in_longitude Float?
  check_out_latitude Float?
  check_out_longitude Float?

  @@unique([employee_cuid, date])
  @@index([employee_cuid])
  @@index([date])
  @@map("attendance_records")
}

model Shift {
  id BigInt @id @default(autoincrement())

  cuid String @unique @default(cuid())

  shift_name String @unique @db.VarChar(100)

  start_time DateTime @db.Time(6)

  end_time DateTime @db.Time(6)

  minimum_work_hours Decimal @db.Decimal(4, 2)

  status Boolean @default(true)

  created_by String? @db.VarChar(255)

  updated_by String? @db.VarChar(255)

  created_at DateTime @default(now()) @db.Timestamptz()

  updated_at DateTime @updatedAt @db.Timestamptz()

  @@map("shifts")
}

model Role {
  id BigInt @id @default(autoincrement())

  cuid String @unique @default(cuid())

  name String @unique @db.VarChar(150)

  status Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)

  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@map("roles")
}

model CompanyLocation {
  id BigInt @id @default(autoincrement())

  cuid String @unique @default(cuid())

  name String @unique @db.VarChar(150)

  address_line1 String  @db.VarChar(255)
  address_line2 String? @db.VarChar(255)

  city String @db.VarChar(100)

  state_cuid   String
  country_cuid String

  pin_code String @db.VarChar(15)

  timezone String @db.VarChar(100)

  status Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz()
  created_by String?  @db.VarChar(100)

  updated_at DateTime @updatedAt @db.Timestamptz()
  updated_by String?  @db.VarChar(100)

  @@map("company_locations")
}
