# App
API_BASE_URL="https://preprod.api.pieq.ai/"
# Public app origin — single source for Auth.js redirects, Vite dev port, and runtime config
# Dev:     APP_URL="http://localhost:5173"
# Preprod: APP_URL="https://preprod.app.pieq.ai"
# Prod:    APP_URL="https://app.pieq.ai"
APP_URL="http://localhost:5173"

# OIDC (Keycloak) — public fields
OIDC_URL="https://preprod.auth.pieq.ai/"
OIDC_REALM="pieq-sso"
OIDC_CLIENT_ID="pieq-app"

# Auth.js / server secrets (never exposed to client)
# Keycloak redirect URI: ${APP_URL}/auth/callback/keycloak
AUTH_SECRET="generate-with-openssl-rand-base64-32"
OIDC_CLIENT_SECRET="your-keycloak-client-secret"
AUTH_TRUST_HOST=true

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"
